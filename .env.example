# Приложение
LOG_LEVEL=INFO

# База данных
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tretyakov
# DB_HOST/DB_PORT внутри docker-compose переопределяются на postgres:5432
DB_HOST=localhost
DB_PORT=5432
DB_ECHO=false

# Хранилище файлов: s3 | local
STORAGE_BACKEND=s3

# S3 / MinIO (для тестов)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=audio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# Публичный URL для раздачи аудио напрямую из MinIO
S3_PUBLIC_URL=http://localhost:9000/audio

# TTS
TTS_MODEL_PATH=models/v5_5_ru.pt
TTS_SPEAKER=baya
AUDIO_SAMPLE_RATE=48000

# Автоматический парсер
SYNC_ON_STARTUP=true
SYNC_INTERVAL_SECONDS=86400
SYNC_PAGE_SIZE=1000
# Ограничение страниц списка (для тестов); пусто = весь каталог
# SYNC_MAX_PAGES=1
SYNC_DETAIL_CONCURRENCY=4
SYNC_REQUEST_DELAY=0.1
